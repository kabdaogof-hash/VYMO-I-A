splay: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-subtle);\"\u003e\n          \u003cdiv\u003e\n            \u003ch4 id\u003d\"modalTitle\" style\u003d\"font-size: 0.96rem; font-weight: 700;\"\u003eAperçu du projet\u003c/h4\u003e\n            \u003cspan id\u003d\"modalSubtitle\" style\u003d\"font-size: 0.74rem; color: var(--text-muted);\"\u003eSimulation locale\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cbutton class\u003d\"icon-btn\" onclick\u003d\"closeCreationModal()\"\u003e✕\u003c/button\u003e\n        \u003c/div\u003e\n        \u003cdiv class\u003d\"preview-canvas-wrap\"\u003e\n          \u003ccanvas id\u003d\"modalCanvas\"\u003e\u003c/canvas\u003e\n          \u003cspan class\u003d\"sim-overlay-badge\"\u003eAperçu simulé\u003c/span\u003e\n        \u003c/div\u003e\n        \u003cdiv style\u003d\"padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;\"\u003e\n          \u003cbutton class\u003d\"btn-secondary\" onclick\u003d\"showToast(\u0027Export simulé prêt (prototype)\u0027)\"\u003eExporter\u003c/button\u003e\n          \u003cbutton class\u003d\"btn-primary\" style\u003d\"width: auto; padding: 10px 16px; font-size: 0.84rem;\" onclick\u003d\"closeCreationModal()\"\u003eFermer\u003c/button\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d BOTTOM NAVIGATION \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d --\u003e\n    \u003cnav class\u003d\"bottom-nav\"\u003e\n      \u003cbutton class\u003d\"nav-item active\" data-view\u003d\"dashboard\" onclick\u003d\"switchView(\u0027dashboard\u0027)\"\u003e\n        \u003csvg width\u003d\"21\" height\u003d\"21\" viewBox\u003d\"0 0 24 24\" fill\u003d\"none\" stroke\u003d\"currentColor\" stroke-width\u003d\"2\" stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\"\u003e\n          \u003crect x\u003d\"3\" y\u003d\"3\" width\u003d\"7\" height\u003d\"9\" rx\u003d\"1\"\u003e\u003c/rect\u003e\n          \u003crect x\u003d\"14\" y\u003d\"3\" width\u003d\"7\" height\u003d\"5\" rx\u003d\"1\"\u003e\u003c/rect\u003e\n          \u003crect x\u003d\"14\" y\u003d\"12\" width\u003d\"7\" height\u003d\"9\" rx\u003d\"1\"\u003e\u003c/rect\u003e\n          \u003crect x\u003d\"3\" y\u003d\"16\" width\u003d\"7\" height\u003d\"5\" rx\u003d\"1\"\u003e\u003c/rect\u003e\n        \u003c/svg\u003e\n        \u003cspan\u003eTableau\u003c/span\u003e\n      \u003c/button\u003e\n\n      \u003cbutton class\u003d\"nav-item\" data-view\u003d\"studio\" onclick\u003d\"switchView(\u0027studio\u0027)\"\u003e\n        \u003csvg width\u003d\"21\" height\u003d\"21\" viewBox\u003d\"0 0 24 24\" fill\u003d\"none\" stroke\u003d\"currentColor\" stroke-width\u003d\"2\" stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\"\u003e\n          \u003cpolygon points\u003d\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"\u003e\u003c/polygon\u003e\n        \u003c/svg\u003e\n        \u003cspan\u003eStudio\u003c/span\u003e\n      \u003c/button\u003e\n\n      \u003cbutton class\u003d\"nav-item\" data-view\u003d\"creations\" onclick\u003d\"switchView(\u0027creations\u0027)\"\u003e\n        \u003csvg width\u003d\"21\" height\u003d\"21\" viewBox\u003d\"0 0 24 24\" fill\u003d\"none\" stroke\u003d\"currentColor\" stroke-width\u003d\"2\" stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\"\u003e\n          \u003crect x\u003d\"2\" y\u003d\"2\" width\u003d\"20\" height\u003d\"20\" rx\u003d\"2.18\" ry\u003d\"2.18\"\u003e\u003c/rect\u003e\n          \u003cline x1\u003d\"7\" y1\u003d\"2\" x2\u003d\"7\" y2\u003d\"22\"\u003e\u003c/line\u003e\n          \u003cline x1\u003d\"17\" y1\u003d\"2\" x2\u003d\"17\" y2\u003d\"22\"\u003e\u003c/line\u003e\n          \u003cline x1\u003d\"2\" y1\u003d\"12\" x2\u003d\"22\" y2\u003d\"12\"\u003e\u003c/line\u003e\n        \u003c/svg\u003e\n        \u003cspan\u003eCréations\u003c/span\u003e\n      \u003c/button\u003e\n\n      \u003cbutton class\u003d\"nav-item\" data-view\u003d\"subscriptions\" onclick\u003d\"switchView(\u0027subscriptions\u0027)\"\u003e\n        \u003csvg width\u003d\"21\" height\u003d\"21\" viewBox\u003d\"0 0 24 24\" fill\u003d\"none\" stroke\u003d\"currentColor\" stroke-width\u003d\"2\" stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\"\u003e\n          \u003cpath d\u003d\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\u003e\u003c/path\u003e\n        \u003c/svg\u003e\n        \u003cspan\u003eOffres\u003c/span\u003e\n      \u003c/button\u003e\n    \u003c/nav\u003e\n  \u003c/div\u003e\n\n  \u003cscript\u003e\n    // ---------------- STATE ----------------\n    const state \u003d {\n      credits: 120,\n      currentPlan: \u0027Créateur Pro\u0027,\n      studioMode: \u0027t2v\u0027, // \u0027t2v\u0027 | \u0027i2v\u0027 | \u00273d\u0027\n      ratio: \u002716:9\u0027,\n      style: \u0027Cinématique\u0027,\n      object3D: \u0027Polyèdre Quantique\u0027,\n      camera3D: \u0027Orbite 360°\u0027,\n      selectedImage: \u0027Nébuleuse Violette\u0027,\n      simPlaying: true,\n      simAnimFrame: null,\n      modalAnimFrame: null,\n      creations: [\n        {\n          id: 1,\n          title: \u0027Nébuleuse de Cristal\u0027,\n          mode: \u0027t2v\u0027,\n          modeLabel: \u0027Texte → Vidéo\u0027,\n          style: \u0027Cinématique\u0027,\n          duration: \u00276s\u0027,\n          date: \"Aujourd\u0027hui\",\n          gradient: \u0027linear-gradient(135deg, #4C1D95, #06B6D4)\u0027\n        },\n        {\n          id: 2,\n          title: \u0027Océan Bioluminescent\u0027,\n          mode: \u0027i2v\u0027,\n          modeLabel: \u0027Image → Vidéo\u0027,\n          style: \u0027Onirique\u0027,\n          duration: \u00275s\u0027,\n          date: \u0027Hier\u0027,\n          gradient: \u0027linear-gradient(135deg, #0F172A, #2DD4BF)\u0027\n        },\n        {\n          id: 3,\n          title: \u0027Prisme Quantique 3D\u0027,\n          mode: \u00273d\u0027,\n          modeLabel: \u0027Animation 3D\u0027,\n          style: \u0027Futuriste Néon\u0027,\n          duration: \u00278s\u0027,\n          date: \u0027Il y a 2 jours\u0027,\n          gradient: \u0027linear-gradient(135deg, #7C3AED, #0F172A)\u0027\n        },\n        {\n          id: 4,\n          title: \u0027Aurore sur Neo-Tokyo\u0027,\n          mode: \u0027t2v\u0027,\n          modeLabel: \u0027Texte → Vidéo\u0027,\n          style: \u0027Futuriste Néon\u0027,\n          duration: \u002710s\u0027,\n          date: \u0027Il y a 4 jours\u0027,\n          gradient: \u0027linear-gradient(135deg, #312E81, #06B6D4)\u0027\n        }\n      ]\n    };\n\n    const modeCosts \u003d { t2v: 5, i2v: 8, \u00273d\u0027: 10 };\n\n    // ---------------- WELCOME CANVAS ----------------\n    function initWelcomeCanvas() {\n      const canvas \u003d document.getElementById(\u0027welcomeCanvas\u0027);\n      const ctx \u003d canvas.getContext(\u00272d\u0027);\n      let w, h;\n      const particles \u003d Array.from({ length: 46 }, () \u003d\u003e ({\n        x: Math.random(),\n        y: Math.random(),\n        r: Math.random() * 2.2 + 0.8,\n        vx: (Math.random() - 0.5) * 0.0007,\n        vy: (Math.random() - 0.5) * 0.0007,\n        c: Math.random() \u003e 0.5 ? \u0027#7C3AED\u0027 : \u0027#2DD4BF\u0027\n      }));\n\n      function resize() {\n        w \u003d canvas.width \u003d canvas.offsetWidth;\n        h \u003d canvas.height \u003d canvas.offsetHeight;\n      }\n      resize();\n      window.addEventListener(\u0027resize\u0027, resize);\n\n      let t \u003d 0;\n      function loop() {\n        t +\u003d 0.015;\n        ctx.clearRect(0, 0, w, h);\n\n        // Subtle glowing wave\n        ctx.beginPath();\n        for (let x \u003d 0; x \u003c\u003d w; x +\u003d 8) {\n          const y \u003d h * 0.34 + Math.sin(x * 0.012 + t) * 26 + Math.cos(x * 0.006 - t * 0.7) * 18;\n          x \u003d\u003d\u003d 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);\n        }\n        ctx.strokeStyle \u003d \u0027rgba(45, 212, 191, 0.22)\u0027;\n        ctx.lineWidth \u003d 2;\n        ctx.stroke();\n\n        particles.forEach((p, idx) \u003d\u003e {\n          p.x \u003d (p.x + p.vx + 1) % 1;\n          p.y \u003d (p.y + p.vy + 1) % 1;\n          const px \u003d p.x * w;\n          const py \u003d p.y * h;\n\n          ctx.beginPath();\n          ctx.arc(px, py, p.r, 0, Math.PI * 2);\n          ctx.fillStyle \u003d p.c;\n          ctx.fill();\n\n          for (let j \u003d idx + 1; j \u003c particles.length; j++) {\n            const p2 \u003d particles[j];\n            const dx \u003d (p.x - p2.x) * w;\n            const dy \u003d (p.y - p2.y) * h;\n            const dist \u003d Math.hypot(dx, dy);\n            if (dist \u003c 85) {\n              ctx.beginPath();\n              ctx.moveTo(px, py);\n              ctx.lineTo(p2.x * w, p2.y * h);\n              ctx.strokeStyle \u003d `rgba(139, 92, 246, ${(1 - dist / 85) * 0.22})`;\n              ctx.lineWidth \u003d 1;\n              ctx.stroke();\n            }\n          }\n        });\n        requestAnimationFrame(loop);\n      }\n      loop();\n    }\n\n    // ---------------- NAVIGATION ----------------\n    function enterApp() {\n      document.getElementById(\u0027welcomeScreen\u0027).classList.add(\u0027hidden\u0027);\n    }\n\n    function showWelcome() {\n      document.getElementById(\u0027welcomeScreen\u0027).classList.remove(\u0027hidden\u0027);\n    }\n\n    function switchView(viewName) {\n      document.querySelectorAll(\u0027.view\u0027).forEach(v \u003d\u003e v.classList.remove(\u0027active\u0027));\n      document.getElementById(`view-${viewName}`).classList.add(\u0027active\u0027);\n\n      document.querySelectorAll(\u0027.nav-item\u0027).forEach(btn \u003d\u003e {\n        btn.classList.toggle(\u0027active\u0027, btn.dataset.view \u003d\u003d\u003d viewName);\n      });\n\n      document.querySelector(\u0027.app-content\u0027).scrollTop \u003d 0;\n    }\n\n    function openStudio(mode) {\n      setStudioMode(mode);\n      switchView(\u0027studio\u0027);\n    }\n\n    function useTemplate(mode, promptText) {\n      openStudio(mode);\n      document.getElementById(\u0027promptInput\u0027).value \u003d promptText;\n      showToast(\u0027Modèle chargé dans le studio\u0027);\n    }\n\n    // ---------------- STUDIO LOGIC ----------------\n    function setStudioMode(mode) {\n      state.studioMode \u003d mode;\n      document.querySelectorAll(\u0027.studio-tab\u0027).forEach(t \u003d\u003e {\n        t.classList.toggle(\u0027active\u0027, t.dataset.mode \u003d\u003d\u003d mode);\n      });\n\n      document.getElementById(\u0027i2v-block\u0027).style.display \u003d mode \u003d\u003d\u003d \u0027i2v\u0027 ? \u0027block\u0027 : \u0027none\u0027;\n      document.getElementById(\u00273d-block\u0027).style.display \u003d mode \u003d\u003d\u003d \u00273d\u0027 ? \u0027block\u0027 : \u0027none\u0027;\n\n      const promptTitles \u003d {\n        t2v: \u0027Prompt créatif (Texte en vidéo)\u0027,\n        i2v: \u0027Mouvement souhaité (Image en vidéo)\u0027,\n        \u00273d\u0027: \u0027Ambiance \u0026 éclairage 3D\u0027\n      };\n      document.getElementById(\u0027promptTitle\u0027).textContent \u003d promptTitles[mode];\n      document.getElementById(\u0027generateBtnLabel\u0027).textContent \u003d `Simuler l\u0027aperçu (${modeCosts[mode]}⚡)`;\n    }\n\n    function selectChip(el, group) {\n      el.parentElement.querySelectorAll(\u0027.choice-chip\u0027).forEach(c \u003d\u003e c.classList.remove(\u0027active\u0027));\n      el.classList.add(\u0027active\u0027);\n      if (group \u003d\u003d\u003d \u0027style\u0027) state.style \u003d el.textContent;\n      if (group \u003d\u003d\u003d \u00273dObject\u0027) state.object3D \u003d el.textContent;\n      if (group \u003d\u003d\u003d \u0027camera\u0027) state.camera3D \u003d el.textContent;\n    }\n\n    function selectRatio(el, ratio) {\n      el.parentElement.querySelectorAll(\u0027.choice-chip\u0027).forEach(c \u003d\u003e c.classList.remove(\u0027active\u0027));\n      el.classList.add(\u0027active\u0027);\n      state.ratio \u003d ratio;\n      const wrap \u003d document.getElementById(\u0027previewCanvasWrap\u0027);\n      wrap.classList.remove(\u0027ratio-916\u0027, \u0027ratio-11\u0027);\n      if (ratio \u003d\u003d\u003d \u00279:16\u0027) wrap.classList.add(\u0027ratio-916\u0027);\n      if (ratio \u003d\u003d\u003d \u00271:1\u0027) wrap.classList.add(\u0027ratio-11\u0027);\n    }\n\n    function selectPresetImage(el, name) {\n      document.querySelectorAll(\u0027.preset-img-card\u0027).forEach(c \u003d\u003e c.classList.remove(\u0027active\u0027));\n      el.classList.add(\u0027active\u0027);\n      state.selectedImage \u003d name;\n      document.getElementById(\u0027selectedImgLabel\u0027).textContent \u003d name;\n    }\n\n    function handleImageUpload(e) {\n      const file \u003d e.target.files[0];\n      if (!file) return;\n      state.selectedImage \u003d file.name;\n      document.getElementById(\u0027selectedImgLabel\u0027).textContent \u003d file.name.slice(0, 20);\n      showToast(\u0027Image sélectionnée (prototype)\u0027);\n    }\n\n    function fillRandomPrompt() {\n      const ideas \u003d {\n        t2v: [\n          \"Une métropole suspendue dans les nuages violets, traînées lumineuses turquoise et caméra fluide.\",\n          \"Un papillon holographique traversant une forêt nocturne aux reflets cristallins.\",\n          \"Vague d\u0027énergie cosmique formant un portail temporel au-dessus d\u0027un lac miroir.\"\n        ],\n        i2v: [\n          \"Travelling avant progressif avec particules dorées et brume flottante.\",\n          \"Parallaxe 3D douce avec ondulation de lumière cyan sur les contours.\",\n          \"Rotation atmosphérique et scintillement des étoiles en arrière-plan.\"\n        ],\n        \u00273d\u0027: [\n          \"Éclairage studio cyberpunk violet et turquoise, reflets métalliques haute brillance.\",\n          \"Ambiance spatiale minimaliste avec halo néon autour de l\u0027objet central.\",\n          \"Rendu holographique translucide sur fond bleu nuit profond.\"\n        ]\n      };\n      const pool \u003d ideas[state.studioMode];\n      const pick \u003d pool[Math.floor(Math.random() * pool.length)];\n      document.getElementById(\u0027promptInput\u0027).value \u003d pick;\n    }\n\n    // ---------------- SIMULATION PLAYER ----------------\n    function runSimulation() {\n      const cost \u003d modeCosts[state.studioMode];\n      if (state.credits \u003c cost) {\n        showToast(\u0027Crédits insuffisants — Passez à une offre supérieure\u0027);\n        switchView(\u0027subscriptions\u0027);\n        return;\n      }\n\n      const promptVal \u003d document.getElementById(\u0027promptInput\u0027).value.trim();\n      if (!promptVal) {\n        fillRandomPrompt();\n      }\n\n      updateCredits(state.credits - cost);\n\n      const stage \u003d document.getElementById(\u0027previewStage\u0027);\n      const loader \u003d document.getElementById(\u0027loaderOverlay\u0027);\n      const fill \u003d document.getElementById(\u0027progressFill\u0027);\n      const stepTxt \u003d document.getElementById(\u0027loaderStep\u0027);\n\n      stage.classList.add(\u0027visible\u0027);\n      loader.style.display \u003d \u0027flex\u0027;\n      fill.style.width \u003d \u00278%\u0027;\n\n      const steps \u003d [\n        \u0027Analyse du scénario et du style...\u0027,\n        \u0027Composition de la scène visuelle...\u0027,\n        \u0027Simulation des images clés...\u0027,\n        \u0027Finalisation de l’aperçu interactif...\u0027\n      ];\n\n      let progress \u003d 10;\n      let stepIdx \u003d 0;\n      const timer \u003d setInterval(() \u003d\u0