    font-size: 0.82rem;\n      font-weight: 600;\n      margin-bottom: 3px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .inspo-body span {\n      font-size: 0.72rem;\n      color: var(--text-muted);\n    }\n\n    /* ---------------- STUDIO MODES ---------------- */\n    .studio-tabs {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 6px;\n      padding: 5px;\n      border-radius: 16px;\n      background: rgba(16, 24, 52, 0.85);\n      border: 1px solid var(--border-subtle);\n      margin-bottom: 16px;\n    }\n\n    .studio-tab {\n      padding: 10px 6px;\n      border-radius: 12px;\n      border: none;\n      background: transparent;\n      color: var(--text-muted);\n      font-size: 0.76rem;\n      font-weight: 600;\n      cursor: pointer;\n      transition: 0.2s;\n      text-align: center;\n    }\n\n    .studio-tab.active {\n      background: var(--gradient-primary);\n      color: white;\n      box-shadow: 0 4px 14px rgba(124, 58, 237, 0.38);\n    }\n\n    .form-group {\n      margin-bottom: 16px;\n    }\n\n    .form-label {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      font-size: 0.82rem;\n      font-weight: 600;\n      color: #CBD5E1;\n      margin-bottom: 8px;\n    }\n\n    .prompt-area {\n      width: 100%;\n      min-height: 104px;\n      padding: 14px;\n      border-radius: 16px;\n      background: rgba(5, 8, 20, 0.7);\n      border: 1px solid rgba(139, 92, 246, 0.28);\n      color: white;\n      font-family: inherit;\n      font-size: 0.88rem;\n      line-height: 1.5;\n      resize: none;\n      outline: none;\n      transition: border-color 0.2s;\n    }\n\n    .prompt-area:focus {\n      border-color: var(--turquoise);\n    }\n\n    .chips-row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n\n    .choice-chip {\n      padding: 8px 13px;\n      border-radius: 12px;\n      background: rgba(255, 255, 255, 0.05);\n      border: 1px solid var(--border-subtle);\n      color: var(--text-muted);\n      font-size: 0.78rem;\n      font-weight: 600;\n      cursor: pointer;\n      transition: 0.2s;\n    }\n\n    .choice-chip.active {\n      background: rgba(6, 182, 212, 0.16);\n      border-color: var(--turquoise);\n      color: var(--turquoise-glow);\n    }\n\n    /* Upload Dropzone (Image to Video) */\n    .upload-zone {\n      border: 1.5px dashed rgba(6, 182, 212, 0.45);\n      border-radius: 18px;\n      padding: 18px;\n      text-align: center;\n      background: rgba(6, 182, 212, 0.05);\n      cursor: pointer;\n      transition: 0.2s;\n      margin-bottom: 12px;\n    }\n\n    .upload-zone:hover {\n      background: rgba(6, 182, 212, 0.1);\n    }\n\n    .preset-images {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 8px;\n    }\n\n    .preset-img-card {\n      height: 68px;\n      border-radius: 12px;\n      position: relative;\n      overflow: hidden;\n      cursor: pointer;\n      border: 2px solid transparent;\n      display: flex;\n      align-items: flex-end;\n      padding: 6px;\n      font-size: 0.68rem;\n      font-weight: 700;\n    }\n\n    .preset-img-card.active {\n      border-color: var(--turquoise-glow);\n      box-shadow: 0 0 14px rgba(45, 212, 191, 0.4);\n    }\n\n    /* Range Slider */\n    .range-wrap {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n\n    input[type\u003d\"range\"] {\n      flex: 1;\n      accent-color: var(--turquoise);\n      cursor: pointer;\n    }\n\n    /* Simulated Preview Player */\n    .preview-stage {\n      margin-top: 18px;\n      border-radius: 20px;\n      background: #03050d;\n      border: 1px solid rgba(139, 92, 246, 0.35);\n      overflow: hidden;\n      display: none;\n    }\n\n    .preview-stage.visible {\n      display: block;\n      animation: fadeSlide 0.35s ease;\n    }\n\n    .preview-canvas-wrap {\n      position: relative;\n      width: 100%;\n      aspect-ratio: 16 / 9;\n      background: #040711;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n    }\n\n    .preview-canvas-wrap.ratio-916 {\n      aspect-ratio: 9 / 12;\n      max-height: 320px;\n    }\n\n    .preview-canvas-wrap.ratio-11 {\n      aspect-ratio: 1 / 1;\n      max-height: 290px;\n    }\n\n    #simCanvas {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    .sim-overlay-badge {\n      position: absolute;\n      top: 10px;\n      left: 10px;\n      padding: 4px 10px;\n      border-radius: 999px;\n      background: rgba(5, 8, 20, 0.78);\n      border: 1px solid rgba(45, 212, 191, 0.4);\n      font-size: 0.68rem;\n      font-weight: 600;\n      color: var(--turquoise-glow);\n      backdrop-filter: blur(8px);\n    }\n\n    .loader-overlay {\n      position: absolute;\n      inset: 0;\n      background: rgba(5, 8, 20, 0.9);\n      backdrop-filter: blur(10px);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n      text-align: center;\n      z-index: 5;\n    }\n\n    .spinner-ring {\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      border: 3px solid rgba(124, 58, 237, 0.25);\n      border-top-color: var(--turquoise-glow);\n      animation: spin 0.9s linear infinite;\n      margin-bottom: 12px;\n    }\n\n    @keyframes spin {\n      to { transform: rotate(360deg); }\n    }\n\n    .progress-bar-bg {\n      width: 80%;\n      height: 6px;\n      border-radius: 999px;\n      background: rgba(255, 255, 255, 0.1);\n      overflow: hidden;\n      margin-top: 10px;\n    }\n\n    .progress-bar-fill {\n      height: 100%;\n      width: 0%;\n      background: var(--gradient-primary);\n      transition: width 0.25s ease;\n    }\n\n    .preview-controls {\n      padding: 12px 14px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 10px;\n      background: rgba(11, 17, 38, 0.9);\n      border-top: 1px solid var(--border-subtle);\n    }\n\n    /* ---------------- MES CRÉATIONS ---------------- */\n    .filter-pills {\n      display: flex;\n      gap: 8px;\n      overflow-x: auto;\n      margin-bottom: 14px;\n      scrollbar-width: none;\n    }\n    .filter-pills::-webkit-scrollbar { display: none; }\n\n    .creations-list {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n\n    .creation-card {\n      background: var(--bg-card);\n      border: 1px solid var(--border-subtle);\n      border-radius: 20px;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .creation-thumb {\n      height: 132px;\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n    }\n\n    .play-circle {\n      width: 46px;\n      height: 46px;\n      border-radius: 50%;\n      background: rgba(5, 8, 20, 0.68);\n      border: 1px solid rgba(255, 255, 255, 0.28);\n      backdrop-filter: blur(8px);\n      display: grid;\n      place-items: center;\n      color: white;\n      transition: transform 0.2s;\n    }\n\n    .creation-thumb:hover .play-circle {\n      transform: scale(1.08);\n      border-color: var(--turquoise-glow);\n    }\n\n    .creation-meta {\n      padding: 13px 15px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .creation-meta h4 {\n      font-size: 0.92rem;\n      font-weight: 700;\n      margin-bottom: 4px;\n    }\n\n    .creation-meta p {\n      font-size: 0.74rem;\n      color: var(--text-muted);\n    }\n\n    /* ---------------- ABONNEMENTS ---------------- */\n    .billing-toggle {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      margin-bottom: 16px;\n      padding: 6px;\n      border-radius: 14px;\n      background: rgba(16, 24, 52, 0.8);\n      border: 1px solid var(--border-subtle);\n    }\n\n    .billing-opt {\n      flex: 1;\n      padding: 9px;\n      border-radius: 10px;\n      border: none;\n      background: transparent;\n      color: var(--text-muted);\n      font-size: 0.8rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n\n    .billing-opt.active {\n      background: rgba(124, 58, 237, 0.3);\n      color: white;\n      border: 1px solid rgba(168, 85, 247, 0.45);\n    }\n\n    .plan-card {\n      background: var(--bg-card);\n      border: 1px solid var(--border-subtle);\n      border-radius: 22px;\n      padding: 18px;\n      margin-bottom: 14px;\n      position: relative;\n      transition: 0.2s;\n    }\n\n    .plan-card.popular {\n      background: linear-gradient(160deg, rgba(124, 58, 237, 0.2) 0%, rgba(11, 17, 38, 0.95) 60%, rgba(6, 182, 212, 0.16) 100%);\n      border-color: rgba(168, 85, 247, 0.55);\n      box-shadow: 0 10px 30px rgba(124, 58, 237, 0.18);\n    }\n\n    .popular-tag {\n      position: absolute;\n      top: 14px;\n      right: 14px;\n      font-size: 0.68rem;\n      font-weight: 700;\n      padding: 4px 10px;\n      border-radius: 999px;\n      background: var(--gradient-primary);\n      color: white;\n    }\n\n    .plan-name {\n      font-family: \u0027Space Grotesk\u0027, sans-serif;\n      font-size: 1.15rem;\n      font-weight: 700;\n      margin-bottom: 4px;\n    }\n\n    .plan-price {\n      font-family: \u0027Space Grotesk\u0027, sans-serif;\n      font-size: 1.85rem;\n      font-weight: 700;\n      margin: 10px 0;\n    }\n\n    .plan-price span {\n      font-size: 0.82rem;\n      font-weight: 500;\n      color: var(--text-muted);\n    }\n\n    .plan-features {\n      list-style: none;\n      margin: 12px 0 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n\n    .plan-features li {\n      font-size: 0.82rem;\n      color: #CBD5E1;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    /* ---------------- BOTTOM NAVIGATION ---------------- */\n    .bottom-nav {\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      z-index: 20;\n      padding: 10px 12px calc(10px + var(--safe-bottom));\n      background: rgba(5, 8, 20, 0.88);\n      backdrop-filter: blur(20px);\n      border-top: 1px solid rgba(255, 255, 255, 0.08);\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 4px;\n    }\n\n    .nav-item {\n      background: none;\n      border: none;\n      color: var(--text-dim);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 4px;\n      padding: 6px 4px;\n      border-radius: 14px;\n      cursor: pointer;\n      transition: 0.2s;\n      font-family: inherit;\n    }\n\n    .nav-item span {\n      font-size: 0.69rem;\n      font-weight: 600;\n    }\n\n    .nav-item.active {\n      color: var(--turquoise-glow);\n    }\n\n    .nav-item.active svg {\n      filter: drop-shadow(0 0 8px rgba(45, 212, 191, 0.5));\n    }\n\n    /* Toast Notification */\n    .toast {\n      position: absolute;\n      top: 72px;\n      left: 50%;\n      transform: translateX(-50%) translateY(-16px);\n      background: rgba(11, 17, 38, 0.96);\n      border: 1px solid var(--turquoise);\n      color: white;\n      padding: 10px 16px;\n      border-radius: 14px;\n      font-size: 0.8rem;\n      font-weight: 600;\n      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);\n      opacity: 0;\n      pointer-events: none;\n      transition: 0.28s ease;\n      z-index: 80;\n      white-space: nowrap;\n    }\n\n    .toast.show {\n      opacity: 1;\n      transform: translateX(-50%) translateY(0);\n    }\n\n    /* Modal Preview for Creations */\n    .modal-backdrop {\n      position: absolute;\n      inset: 0;\n      z-index: 60;\n      background: rgba(2, 4, 10, 0.85);\n      backdrop-filter: blur(12px);\n      display: none;\n      align-items: center;\n      justify-content: cen