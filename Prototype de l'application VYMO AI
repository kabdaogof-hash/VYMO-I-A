\n        const id \u003d requestAnimationFrame(draw);\n        if (checkPlayState) state.simAnimFrame \u003d id;\n        else state.modalAnimFrame \u003d id;\n      }\n      draw();\n    }\n\n    function saveCurrentCreation() {\n      const prompt \u003d document.getElementById(\u0027promptInput\u0027).value.trim() || \u0027Création VYMO\u0027;\n      const title \u003d prompt.length \u003e 26 ? prompt.slice(0, 26) + \u0027...\u0027 : prompt;\n      const modeLabels \u003d { t2v: \u0027Texte → Vidéo\u0027, i2v: \u0027Image → Vidéo\u0027, \u00273d\u0027: \u0027Animation 3D\u0027 };\n      const grads \u003d {\n        t2v: \u0027linear-gradient(135deg, #5B21B6, #06B6D4)\u0027,\n        i2v: \u0027linear-gradient(135deg, #0F172A, #2DD4BF)\u0027,\n        \u00273d\u0027: \u0027linear-gradient(135deg, #7C3AED, #312E81)\u0027\n      };\n\n      state.creations.unshift({\n        id: Date.now(),\n        title,\n        mode: state.studioMode,\n        modeLabel: modeLabels[state.studioMode],\n        style: state.style,\n        duration: document.getElementById(\u0027durationRange\u0027).value + \u0027s\u0027,\n        date: \"À l\u0027instant\",\n        gradient: grads[state.studioMode]\n      });\n\n      renderCreations(\u0027all\u0027);\n      document.getElementById(\u0027statCreations\u0027).textContent \u003d state.creations.length;\n      showToast(\u0027Projet ajouté dans Mes créations\u0027);\n    }\n\n    // ---------------- MES CRÉATIONS ----------------\n    function renderCreations(filter \u003d \u0027all\u0027) {\n      const container \u003d document.getElementById(\u0027creationsList\u0027);\n      const filtered \u003d filter \u003d\u003d\u003d \u0027all\u0027 ? state.creations : state.creations.filter(c \u003d\u003e c.mode \u003d\u003d\u003d filter);\n      document.getElementById(\u0027creationsCounter\u0027).textContent \u003d `${filtered.length} projet${filtered.length \u003e 1 ? \u0027s\u0027 : \u0027\u0027}`;\n\n      if (!filtered.length) {\