.26) 0%, rgba(11, 17, 38, 0.92) 55%, rgba(6, 182, 212, 0.22) 100%);\n      border: 1px solid rgba(139, 92, 246, 0.35);\n      border-radius: 24px;\n      padding: 20px;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .dash-banner h2 {\n      font-family: \u0027Space Grotesk\u0027, sans-serif;\n      font-size: 1.32rem;\n      margin-bottom: 6px;\n    }\n\n    .dash-banner p {\n      font-size: 0.85rem;\n      color: var(--text-muted);\n      margin-bottom: 16px;\n      line-height: 1.45;\n    }\n\n    .stats-row {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 10px;\n      margin-top: 14px;\n    }\n\n    .stat-box {\n      background: rgba(5, 8, 20, 0.55);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 14px;\n      padding: 10px;\n      text-align: center;\n    }\n\n    .stat-val {\n      font-family: \u0027Space Grotesk\u0027, sans-serif;\n      font-size: 1.15rem;\n      font-weight: 700;\n      color: white;\n    }\n\n    .stat-lbl {\n      font-size: 0.7rem;\n      color: var(--text-muted);\n      margin-top: 2px;\n    }\n\n    /* Tool Cards Grid */\n    .tools-grid {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n\n    .tool-card {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      padding: 15px;\n      border-radius: 20px;\n      background: var(--bg-card);\n      border: 1px solid var(--border-subtle);\n      cursor: pointer;\n      transition: transform 0.2s, border-color 0.2s, background 0.2s;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .tool-card:hover {\n      background: var(--bg-card-hover);\n      border-color: rgba(139, 92, 246, 0.45);\n      transform: translateY(-2px);\n    }\n\n    .tool-icon {\n      width: 50px;\n      height: 50px;\n      border-radius: 16px;\n      display: grid;\n      place-items: center;\n      flex-shrink: 0;\n    }\n\n    .tool-icon.t2v {\n      background: linear-g